<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="AgoraIn.Mobile.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="我的"
    BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Border BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="UsernameLabel" Text="未登录" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="RoleLabel" Text="" FontSize="13" TextColor="#888888" />
                    <Label x:Name="ServerLabel" Text="" FontSize="12" TextColor="#bbbbbb" />
                </VerticalStackLayout>
            </Border>

            <!-- 服务器地址固定为官方域名，不可修改 -->
            <Border BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="服务器" FontSize="16" FontAttributes="Bold" />
                    <Label x:Name="ServerEntry" Text="https://agorain.615mc.cn"
                           FontSize="14" TextColor="#4285f4" />
                    <Label Text="本应用统一连接官方服务器，不支持自定义服务器地址"
                           FontSize="12" TextColor="#999999" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="LoginButton" Text="登录" BackgroundColor="#4285f4" TextColor="White"
                    CornerRadius="10" HeightRequest="46" Clicked="OnLoginClicked" />
            <Button x:Name="LogoutButton" Text="退出登录" BackgroundColor="#FCE8E6" TextColor="#C5221F"
                    CornerRadius="10" HeightRequest="46" IsVisible="False" Clicked="OnLogoutClicked" />

            <Label Text="AgoraIn v4.0 · 学生端" FontSize="12" TextColor="#bbbbbb"
                   HorizontalOptions="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
