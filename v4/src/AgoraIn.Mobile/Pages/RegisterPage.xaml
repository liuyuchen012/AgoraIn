<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="AgoraIn.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="注册"
    BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="560">

            <Label Text="注册 AgoraIn 账户" FontSize="22" FontAttributes="Bold"
                   HorizontalOptions="Center" Margin="0,12,0,0" />
            <Label Text="家长注册加入孩子的区域；机构注册创建独立区域"
                   FontSize="13" TextColor="#888888" HorizontalOptions="Center" />

            <Picker x:Name="ModePicker" SelectedIndexChanged="OnModeChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>家长注册（加入已有区域）</x:String>
                        <x:String>机构注册（创建新区域）</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry x:Name="EmailEntry" Placeholder="邮箱（接收验证码）" Keyboard="Email" />
            <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                <Entry x:Name="CodeEntry" Placeholder="邮箱验证码" />
                <Button x:Name="SendCodeButton" Grid.Column="1" Text="获取验证码" BackgroundColor="#4285f4"
                        TextColor="White" CornerRadius="8" Clicked="OnSendCodeClicked" />
            </Grid>
            <Entry x:Name="UsernameEntry" Placeholder="用户名（字母/数字/下划线/短横线，不含 @）" />
            <Entry x:Name="PasswordEntry" Placeholder="密码（至少 6 位）" IsPassword="True" />

            <!-- 家长模式：区域代号 -->
            <Entry x:Name="RegionIdEntry" Placeholder="绑定邀请码（向老师索取 6 位码，注册即绑定孩子）" Unfocused="OnInviteCodeUnfocused" />

            <!-- 机构自定义隐私政策（区域管理员制作时展示） -->
            <Border x:Name="RegionAgreementCard" IsVisible="False" BackgroundColor="White"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="RegionAgreementTitle" FontSize="14" FontAttributes="Bold" TextColor="#174ea6" />
                    <ScrollView MaximumHeightRequest="180">
                        <Label x:Name="RegionAgreementBody" FontSize="13" LineBreakMode="WordWrap" />
                    </ScrollView>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <CheckBox x:Name="AgreeRegionCheck" IsChecked="False" />
                        <Label x:Name="AgreeRegionLabel" Text="我已阅读并同意该机构的隐私政策" FontSize="13"
                               TextColor="#333333" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <!-- 机构模式：区域名称 -->
            <Entry x:Name="RegionNameEntry" Placeholder="区域名称（机构/学校名称，不可重复）" IsVisible="False" />

            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                <CheckBox x:Name="AgreeCheck" IsChecked="False" />
                <Label Text="我已阅读并同意" FontSize="13" TextColor="#666666" VerticalOptions="Center" />
                <Label Text="《服务条款》" FontSize="13" TextColor="#4285f4" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTermsClicked" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="与" FontSize="13" TextColor="#666666" VerticalOptions="Center" />
                <Label Text="《隐私政策》" FontSize="13" TextColor="#4285f4" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrivacyClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Button x:Name="SubmitButton" Text="注册" BackgroundColor="#34a853" TextColor="White"
                    CornerRadius="10" HeightRequest="50" Clicked="OnSubmitClicked" />

            <Button Text="已有账户？返回登录" BackgroundColor="Transparent" TextColor="#4285f4"
                    Clicked="OnBackToLoginClicked" />

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False"
                               Color="#4285f4" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
