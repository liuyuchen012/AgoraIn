<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AgoraIn.Mobile.Controls"
             x:Class="AgoraIn.Mobile.Pages.AnswerSheetScannerPage"
             Title="扫描答题卡">

    <!-- 动态扫卡改为内嵌网页端 /scan：摄像头实时取流 → 必须读到卡面右下角页码二维码 →
         同一页保持 2 秒自动上传。识别、多页归并、考号闸门都在服务端，App 只负责承载页面
         （并给网页授予摄像头权限）。 -->
    <Grid>
        <controls:CameraWebView x:Name="Web" />
        <VerticalStackLayout x:Name="LoadingBox" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
            <ActivityIndicator IsRunning="True" Color="#4285f4" />
            <Label Text="正在加载动态扫卡…" FontSize="13" TextColor="#909399" HorizontalOptions="Center" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="ErrorBox" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="24">
            <Label x:Name="ErrorLabel" FontSize="14" TextColor="#f56c6c" HorizontalOptions="Center" />
            <Button Text="重试" Clicked="OnRetry" HorizontalOptions="Center" CornerRadius="10" BackgroundColor="#4285f4" TextColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
