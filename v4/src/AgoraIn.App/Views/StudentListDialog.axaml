<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgoraIn.App.ViewModels"
        x:Class="AgoraIn.App.Views.StudentListDialog"
        x:DataType="vm:StudentListDialogViewModel"
        x:CompileBindings="True"
        Title="学生列表"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F8F9FA">

  <Border Padding="16">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBox Grid.Column="0" Text="{Binding NewName}" Watermark="输入学生姓名"
                 KeyDown="OnNewNameKeyDown" />
        <Button Grid.Column="1" Content="添加" Margin="8,0,0,0" Padding="16,6"
                Command="{Binding AddCommand}" Background="#4285f4" Foreground="White"
                CornerRadius="6" FontWeight="SemiBold" />
      </Grid>

      <ListBox Grid.Row="1" ItemsSource="{Binding Students}"
               Background="White" CornerRadius="8" BorderBrush="#E0E4E8" BorderThickness="1"
               SelectionMode="Multiple">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" Margin="4,0">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0"
                        VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                         VerticalAlignment="Center" Padding="0,6" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Button Grid.Row="2" Content="删除选中" HorizontalAlignment="Left" Margin="0,8,0,0"
              Padding="16,6" CornerRadius="6" Foreground="#d32f2f"
              Command="{Binding RemoveSelectedCommand}" />

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="取消" Padding="16,8" Margin="0,0,8,0" CornerRadius="6"
                Click="OnCancelClick" />
        <Button Content="保存" Padding="16,8" CornerRadius="6"
                Background="#4285f4" Foreground="White" FontWeight="SemiBold"
                Command="{Binding SaveCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
