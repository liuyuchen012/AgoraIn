<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgoraIn.App.ViewModels"
        xmlns:models="using:AgoraIn.App.Models"
        xmlns:conv="using:AgoraIn.App.Converters"
        x:Class="AgoraIn.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="AgoraIn v4"
        Icon="avares://AgoraIn/Assets/app-icon.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="48"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei">

  <Window.Styles>
    <!-- ═══ 标题栏扁平按钮（菜单用，保留默认模板以支持 Flyout） ═══ -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20FFFFFF" />
    </Style>

    <!-- ═══ 窗口控制按钮 ═══ -->
    <Style Selector="Button.titlebar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brand.Red}" />
    </Style>

    <Style Selector="TextBlock.tree-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tree-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="2,1" />
    </Style>
    <Style Selector="Border.tree-item:pointerover">
      <Setter Property="Background" Value="#e8f0fe" />
    </Style>
    <Style Selector="Border.tree-item.selected">
      <Setter Property="Background" Value="#d2e3fc" />
    </Style>

    <Style Selector="Button.student">
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="52" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#e8e8e8" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="BorderBrush" Value="#d0d0d0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.student:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.student.checked">
      <Setter Property="Background" Value="#4285f4" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4285f4" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#333333" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#888888" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border CornerRadius="12" ClipToBounds="True" Background="White">
      <Grid ColumnDefinitions="200,*">

        <!-- ═══ 左侧栏（200px，三种模式共用，内容按模式切换） ═══ -->
        <Border Grid.Column="0" Background="#f5f5f5">
          <Grid RowDefinitions="48,*">
            <!-- 顶部品牌栏 -->
            <Border Grid.Row="0" Background="#4285f4">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Ellipse Width="10" Height="10" Fill="White" Opacity="0.9" />
                <TextBlock Text=" AgoraIn" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- 大屏模式：任务树 -->
            <ScrollViewer Grid.Row="1" Padding="8,8,8,0" IsVisible="{Binding IsLargeScreen}">
              <ItemsControl ItemsSource="{Binding TaskTree}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:TaskTreeNode">
                    <Border Classes="tree-item" Tag="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#666666"
                                   Text="&#xE8B7;" VerticalAlignment="Center" />
                        <TextBlock Classes="tree-label" Text="{Binding DisplayName}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- 控制模式：导航 -->
            <StackPanel Grid.Row="1" IsVisible="{Binding IsControlMode}" Margin="0,4,0,0">
              <TextBlock Text="划课" FontSize="13" Padding="22,10" Foreground="#4285f4" FontWeight="SemiBold"
                         Cursor="Hand" Tag="划课" />
              <TextBlock Text="设备列表" FontSize="13" Padding="22,10" Foreground="#888888" Cursor="Hand" />
              <TextBlock Text="任务中心" FontSize="13" Padding="22,10" Foreground="#888888" Cursor="Hand" />
              <TextBlock Text="集控平台列表" FontSize="13" Padding="22,10" Foreground="#888888" Cursor="Hand" />
            </StackPanel>

            <!-- 教师模式：导航 -->
            <StackPanel Grid.Row="1" IsVisible="{Binding IsTeacherMode}" Margin="0,4,0,0">
              <TextBlock Text="点名" FontSize="13" Padding="22,10" Foreground="#4285f4" FontWeight="SemiBold"
                         Cursor="Hand" PointerPressed="OnTeacherNavClick" Tag="点名" />
              <TextBlock Text="积分" FontSize="13" Padding="22,10" Foreground="#888888"
                         Cursor="Hand" PointerPressed="OnTeacherNavClick" Tag="积分" />
              <TextBlock Text="值日" FontSize="13" Padding="22,10" Foreground="#888888"
                         Cursor="Hand" PointerPressed="OnTeacherNavClick" Tag="值日" />
              <TextBlock Text="座位" FontSize="13" Padding="22,10" Foreground="#888888"
                         Cursor="Hand" PointerPressed="OnTeacherNavClick" Tag="座位" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ═══ 右侧：主内容区 ═══ -->
        <Grid Grid.Column="1" RowDefinitions="48,36,*,28">

          <!-- 标题栏 -->
          <Grid Grid.Row="0" Background="#4285f4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <TextBlock Text="{Binding SelectedMode.DisplayName}" FontSize="13" Foreground="White"
                         VerticalAlignment="Center" Margin="12,0,10,0" Cursor="Hand"
                         PointerPressed="OnModeClick" />
              <Button Content="设置" Classes="flat" Click="OnSettingsClick" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Classes="titlebar" Click="OnMinimizeClick">
                <Path Data="M0,6 H12" Stroke="White" StrokeThickness="1.5" />
              </Button>
              <Button Classes="titlebar" Click="OnMaximizeClick">
                <Path Data="M1,1 H11 V11 H1 Z" Stroke="White" StrokeThickness="1.5" Fill="Transparent" />
              </Button>
              <Button Classes="titlebar titlebar-close" Click="OnCloseClick">
                <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="White" StrokeThickness="1.5" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- 标签栏（仅大屏模式显示） -->
          <Border Grid.Row="1" Background="#f0f0f0" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1"
                  IsVisible="{Binding IsLargeScreen}">
            <Grid>
              <ItemsControl ItemsSource="{Binding Tabs}" Margin="4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Border Padding="12,0" Height="36" MinWidth="100" Cursor="Hand"
                            Background="Transparent" Tag="{Binding}"
                            Tapped="OnTabTapped">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#555555"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text=" ✕" FontSize="10" Foreground="#999999" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="+" FontSize="18" FontWeight="Light" Foreground="#666666"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                         Cursor="Hand" Tapped="OnAddTabTapped" />
            </Grid>
          </Border>

          <!-- 主内容区 -->
          <Panel Grid.Row="2">
            <!-- 大屏模式 -->
            <Grid IsVisible="{Binding IsLargeScreen}" Margin="20,12,20,8" ColumnDefinitions="320,*">
              <!-- 排名卡 -->
              <Border Grid.Column="0" CornerRadius="8" Background="#f8f9fa" Padding="12" Margin="0,0,16,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="打卡排名" Margin="0,0,0,4" />
                  <TextBlock DockPanel.Dock="Top" Classes="hint" Text="最早打卡" Margin="0,0,0,8" />
                  <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Ranking}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:RankingItem">
                        <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                          <Grid ColumnDefinitions="40,*,70">
                            <TextBlock Text="{Binding Rank}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="#333333" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                            <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#888888" FontSize="12"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>

              <!-- 打卡面板 -->
              <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <TextBlock Text="服务器在线" FontSize="13" Foreground="#666666" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand.Green}" IsVisible="{Binding IsOnline}" Margin="0,0,6,0" />
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand.Red}" IsVisible="{Binding !IsOnline}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding OnlineText}" FontSize="12" Foreground="#777777" />
                    </StackPanel>
                  </Grid>

                  <Border CornerRadius="8" Background="#e8f0fe" Padding="14,10" Margin="0,0,0,14">
                    <TextBlock Text="{Binding PunchInfo}" FontSize="14" FontWeight="Medium" Foreground="#4285f4" />
                  </Border>

                  <!-- 学生按钮网格（关闭编译绑定以支持 DataContext 穿透） -->
                  <ItemsControl ItemsSource="{Binding Students}" x:CompileBindings="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ButtonCols}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="student" Content="{Binding Name}"
                                Classes.checked="{Binding IsCheckedIn}"
                                Command="{Binding #Root.DataContext.CheckInCommand}"
                                CommandParameter="{Binding}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="取消打卡"
                                        Command="{Binding #Root.DataContext.CancelCheckInCommand}"
                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- 控制模式 -->
            <Grid IsVisible="{Binding IsControlMode}" ColumnDefinitions="*">
              <Grid RowDefinitions="Auto,*" Background="#fafafa" Margin="24,20,24,16">
                <!-- 课时划消面板 -->
                <Grid Grid.Row="0" ColumnDefinitions="360,1*" Margin="0,0,0,16">
                  <!-- 左：学生列表 + 操作 -->
                  <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Classes="page-title" Text="课时管理" FontSize="18" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding ClassHours.Students}" Height="240" Background="White"
                             BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="8"
                             SelectedItem="{Binding ClassHours.SelectedStudent}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                            <Border Grid.Column="1" Background="#4285f4" CornerRadius="10" Padding="8,2">
                              <TextBlock FontSize="11" Foreground="White" VerticalAlignment="Center">
                                <TextBlock.Text>
                                  <MultiBinding StringFormat="剩余 {0:0.#}">
                                    <Binding Path="RemainingHours" />
                                  </MultiBinding>
                                </TextBlock.Text>
                              </TextBlock>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="0,8,0,0">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <NumericUpDown Grid.Column="0" Value="{Binding ClassHours.OperateHours}" Minimum="0.5" Maximum="100"
                                       Increment="0.5" FormatString="0.#" Width="140" />
                        <Button Grid.Column="1" Content="划消" Margin="8,0,4,0" Padding="12,6"
                                Background="#ea4335" Foreground="White" CornerRadius="6"
                                Command="{Binding ClassHours.DeductCommand}" />
                        <Button Grid.Column="2" Content="赠送" Padding="12,6"
                                Background="#34a853" Foreground="White" CornerRadius="6"
                                Command="{Binding ClassHours.GiftCommand}" />
                      </Grid>
                      <TextBox Text="{Binding ClassHours.OperateNote}" Watermark="备注（可选）" Margin="0,0,0,8" />
                    </StackPanel>
                  </StackPanel>
                  <!-- 右：月历 -->
                  <Grid Grid.Column="1">
                    <Grid RowDefinitions="Auto,Auto,*">
                      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                        <Button Content="◀" Padding="8,4" Command="{Binding ClassHours.PrevMonthCommand}"
                                Background="Transparent" BorderThickness="0" FontSize="14" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Text="{Binding ClassHours.CurrentMonth, StringFormat={}{0:yyyy 年 M 月}}" />
                        <Button Grid.Column="2" Content="▶" Padding="8,4" Command="{Binding ClassHours.NextMonthCommand}"
                                Background="Transparent" BorderThickness="0" FontSize="14" />
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                          <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="一" HorizontalAlignment="Center" FontSize="12" Foreground="#888" />
                        <TextBlock Grid.Column="1" Text="二" HorizontalAlignment="Center" FontSize="12" Foreground="#888" />
                        <TextBlock Grid.Column="2" Text="三" HorizontalAlignment="Center" FontSize="12" Foreground="#888" />
                        <TextBlock Grid.Column="3" Text="四" HorizontalAlignment="Center" FontSize="12" Foreground="#888" />
                        <TextBlock Grid.Column="4" Text="五" HorizontalAlignment="Center" FontSize="12" Foreground="#888" />
                        <TextBlock Grid.Column="5" Text="六" HorizontalAlignment="Center" FontSize="12" Foreground="#888" />
                        <TextBlock Grid.Column="6" Text="日" HorizontalAlignment="Center" FontSize="12" Foreground="#888" />
                      </Grid>
                      <UniformGrid Grid.Row="2" Columns="7" x:CompileBindings="False">
                        <ItemsControl ItemsSource="{Binding ClassHours.CalendarDays}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="Transparent" CornerRadius="6" Margin="2"
                                      Cursor="Hand" Tag="{Binding}"
                                      PointerPressed="OnCalendarDayClick">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                  <TextBlock HorizontalAlignment="Center" FontSize="12"
                                             Foreground="{Binding IsCurrentMonth, Converter={x:Static conv:BoolToForegroundConverter.Instance}}"
                                             Text="{Binding DisplayText}" />
                                  <Border Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                                          Background="#4285f4" IsVisible="{Binding IsToday}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </UniformGrid>
                    </Grid>
                  </Grid>
                </Grid>
                <!-- 课时记录流水 -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E0E4E8" BorderThickness="1" Padding="12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="课时记录" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ClassHours.SelectedDetail}" Classes="hint" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ClassHours.Records}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                            <Grid ColumnDefinitions="80,60,*,100">
                              <TextBlock Text="{Binding Date}" FontSize="12" Foreground="#888" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                         Text="{Binding HoursText}"
                                         Foreground="{Binding IsDeduct, Converter={x:Static conv:HoursToColorConverter.Instance}}" />
                              <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="12" Foreground="#555" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- 教师模式 -->
            <Grid IsVisible="{Binding IsTeacherMode}" ColumnDefinitions="*">
              <!-- 点名面板 -->
              <Panel IsVisible="{Binding Teacher.IsRollCall}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,16">
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <TextBlock Classes="page-title" Text="点名" FontSize="18" VerticalAlignment="Center" />
                    <Button Content="🎲 开始点名" Padding="16,8" CornerRadius="8"
                            Background="#4285f4" Foreground="White" FontWeight="SemiBold"
                            Command="{Binding Teacher.StartRollCallCommand}" />
                    <TextBlock Text="{Binding Teacher.RollCallStatus}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#4285f4" VerticalAlignment="Center" />
                  </StackPanel>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Teacher.RollCallStudents}" Background="White"
                           BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="8">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Padding="12,8" Margin="2,1" CornerRadius="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="13"
                                       Foreground="#4285f4" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Panel>

              <!-- 积分面板 -->
              <Panel IsVisible="{Binding Teacher.IsPoints}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,16">
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <TextBlock Classes="page-title" Text="积分规则" FontSize="18" VerticalAlignment="Center" />
                    <Button Content="+ 添加规则" Padding="12,6" CornerRadius="6"
                            Background="#34a853" Foreground="White"
                            Command="{Binding Teacher.AddPointRuleCommand}" />
                  </StackPanel>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Teacher.PointRules}" Background="White"
                           BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="8">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Padding="12,8" Margin="2,1" CornerRadius="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Text="{Binding Delta, StringFormat='+{0}'}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="2" Text="{Binding Teacher.PointStatus}" Classes="hint" Margin="0,8,0,0" />
                </Grid>
              </Panel>

              <!-- 值日面板 -->
              <Panel IsVisible="{Binding Teacher.IsDuty}">
                <Grid RowDefinitions="Auto,Auto,*" Margin="24,20,24,16">
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <TextBlock Classes="page-title" Text="值日岗位" FontSize="18" VerticalAlignment="Center" />
                    <Button Content="+ 添加岗位" Padding="12,6" CornerRadius="6"
                            Background="#34a853" Foreground="White"
                            Command="{Binding Teacher.AddDutyPostCommand}" />
                  </StackPanel>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Teacher.DutyPosts}" Background="White"
                           BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="8" Height="200">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Padding="12,8" Margin="2,1" CornerRadius="6">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" FontSize="12" Foreground="#888" VerticalAlignment="Center">
                              <TextBlock.Text>
                                <MultiBinding StringFormat="需要 {0} 人">
                                  <Binding Path="Capacity" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="2" Text="{Binding Teacher.DutyStatus}" Classes="hint" Margin="0,8,0,0" />
                </Grid>
              </Panel>

              <!-- 座位面板 -->
              <Panel IsVisible="{Binding Teacher.IsSeats}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                  <TextBlock Text="座位编排" FontSize="16" Foreground="#bbbbbb" HorizontalAlignment="Center" />
                  <TextBlock Text="教室布局编辑器、拖拽调座、打印导出（P3 后续实现）" FontSize="12"
                             Foreground="#cccccc" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
            </Grid>
          </Panel>

          <!-- 底部状态栏 -->
          <Border Grid.Row="3" Background="#f5f5f5" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="右键点击已打卡学生可取消打卡" FontSize="11" Foreground="#aaaaaa" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Panel>
</Window>
