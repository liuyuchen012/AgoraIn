<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgoraIn.App.ViewModels"
        xmlns:models="using:AgoraIn.App.Models"
        xmlns:conv="using:AgoraIn.App.Converters"
        xmlns:controls="using:AgoraIn.App.Controls"
        x:Class="AgoraIn.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="AgoraIn v4"
        Icon="avares://AgoraIn/Assets/app-icon.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="48"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei">

  <Window.Styles>
    <!-- ═══ 标题栏扁平按钮（菜单用，保留默认模板以支持 Flyout） ═══ -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20FFFFFF" />
    </Style>

    <!-- ═══ 窗口控制按钮 ═══ -->
    <Style Selector="Button.titlebar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brand.Red}" />
    </Style>

    <Style Selector="TextBlock.tree-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tree-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="2,1" />
    </Style>
    <Style Selector="Border.tree-item:pointerover">
      <Setter Property="Background" Value="#e8f0fe" />
    </Style>
    <Style Selector="Border.tree-item.selected">
      <Setter Property="Background" Value="#d2e3fc" />
    </Style>

    <Style Selector="Button.student">
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="52" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#e8e8e8" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="BorderBrush" Value="#d0d0d0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.student:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.student.checked">
      <Setter Property="Background" Value="#4285f4" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4285f4" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#333333" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#888888" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border CornerRadius="12" ClipToBounds="True" Background="White">
      <Grid ColumnDefinitions="200,*">

        <!-- ═══ 左侧栏（200px，三种模式共用，内容按模式切换） ═══ -->
        <Border Grid.Column="0" Background="#f5f5f5" IsVisible="{Binding IsLargeScreen}">
          <Grid RowDefinitions="48,*">
            <!-- 顶部品牌栏 -->
            <Border Grid.Row="0" Background="#4285f4">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Ellipse Width="10" Height="10" Fill="White" Opacity="0.9" />
                <TextBlock Text=" AgoraIn" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- 大屏模式：任务树 -->
            <ScrollViewer Grid.Row="1" Padding="8,8,8,0">
              <ItemsControl ItemsSource="{Binding TaskTree}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:TaskTreeNode">
                    <Border Classes="tree-item" Tag="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#666666"
                                   Text="&#xE8B7;" VerticalAlignment="Center" />
                        <TextBlock Classes="tree-label" Text="{Binding DisplayName}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>


          </Grid>
        </Border>

        <!-- ═══ 右侧：主内容区 ═══ -->
        <Grid Grid.Column="1" RowDefinitions="48,36,*,28">

          <!-- 标题栏 -->
          <Grid Grid.Row="0" Background="#4285f4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <TextBlock Text="{Binding SelectedMode.DisplayName}" FontSize="13" Foreground="White"
                         VerticalAlignment="Center" Margin="12,0,10,0" Cursor="Hand"
                         PointerPressed="OnModeClick" />
              <Button Content="设置" Classes="flat" Click="OnSettingsClick" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Classes="titlebar" Click="OnMinimizeClick">
                <Path Data="M0,6 H12" Stroke="White" StrokeThickness="1.5" />
              </Button>
              <Button Classes="titlebar" Click="OnMaximizeClick">
                <Path Data="M1,1 H11 V11 H1 Z" Stroke="White" StrokeThickness="1.5" Fill="Transparent" />
              </Button>
              <Button Classes="titlebar titlebar-close" Click="OnCloseClick">
                <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="White" StrokeThickness="1.5" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- 标签栏（仅大屏模式显示） -->
          <Border Grid.Row="1" Background="#f0f0f0" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1"
                  IsVisible="{Binding IsLargeScreen}">
            <Grid>
              <ItemsControl ItemsSource="{Binding Tabs}" Margin="4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Border Padding="12,0" Height="36" MinWidth="100" Cursor="Hand"
                            Background="Transparent" Tag="{Binding}"
                            Tapped="OnTabTapped">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#555555"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text=" ✕" FontSize="10" Foreground="#999999" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="+" FontSize="18" FontWeight="Light" Foreground="#666666"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                         Cursor="Hand" Tapped="OnAddTabTapped" />
            </Grid>
          </Border>

          <!-- 主内容区 -->
          <Panel Grid.Row="2">
            <!-- 大屏模式 -->
            <Grid IsVisible="{Binding IsLargeScreen}" Margin="20,12,20,8" ColumnDefinitions="320,*">
              <!-- 排名卡 -->
              <Border Grid.Column="0" CornerRadius="8" Background="#f8f9fa" Padding="12" Margin="0,0,16,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="打卡排名" Margin="0,0,0,4" />
                  <TextBlock DockPanel.Dock="Top" Classes="hint" Text="最早打卡" Margin="0,0,0,8" />
                  <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Ranking}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:RankingItem">
                        <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                          <Grid ColumnDefinitions="40,*,70">
                            <TextBlock Text="{Binding Rank}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="#333333" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                            <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#888888" FontSize="12"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>

              <!-- 打卡面板 -->
              <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <TextBlock Text="服务器在线" FontSize="13" Foreground="#666666" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand.Green}" IsVisible="{Binding IsOnline}" Margin="0,0,6,0" />
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand.Red}" IsVisible="{Binding !IsOnline}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding OnlineText}" FontSize="12" Foreground="#777777" />
                    </StackPanel>
                  </Grid>

                  <Border CornerRadius="8" Background="#e8f0fe" Padding="14,10" Margin="0,0,0,14">
                    <TextBlock Text="{Binding PunchInfo}" FontSize="14" FontWeight="Medium" Foreground="#4285f4" />
                  </Border>

                  <!-- 学生按钮网格（关闭编译绑定以支持 DataContext 穿透） -->
                  <ItemsControl ItemsSource="{Binding Students}" x:CompileBindings="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ButtonCols}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="student" Content="{Binding Name}"
                                Classes.checked="{Binding IsCheckedIn}"
                                Command="{Binding #Root.DataContext.CheckInCommand}"
                                CommandParameter="{Binding}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="取消打卡"
                                        Command="{Binding #Root.DataContext.CancelCheckInCommand}"
                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- 控制 / 教师模式：内嵌服务端 Web 管理面板 -->
            <Panel IsVisible="{Binding IsWebPanelMode}">
              <!-- 降级提示：非 Windows 或 WebView2 初始化失败 -->
              <Border IsVisible="{Binding !WebPanelReady}" Background="#fafafa">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                  <TextBlock Text="&#x1F310;" FontSize="48" HorizontalAlignment="Center" />
                  <TextBlock Text="内嵌浏览器不可用" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding WebPanelHint}" FontSize="12" Foreground="#888888"
                             HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
                  <TextBlock Text="{Binding WebPanelUrl}" FontSize="13" Foreground="#4285f4" HorizontalAlignment="Center" />
                  <Button Content="用系统浏览器打开" Padding="16,8" CornerRadius="8"
                          Background="#4285f4" Foreground="White" Click="OnOpenWebPanelInBrowser" />
                </StackPanel>
              </Border>

              <!-- 内嵌网页（Windows + WebView2） -->
              <controls:WebViewHost x:Name="WebHost" Source="{Binding WebPanelUrl}"
                                    IsVisible="{Binding WebPanelReady}" />
            </Panel>
          </Panel>

          <!-- 底部状态栏 -->
          <Border Grid.Row="3" Background="#f5f5f5" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="右键点击已打卡学生可取消打卡" FontSize="11" Foreground="#aaaaaa" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Panel>
</Window>
