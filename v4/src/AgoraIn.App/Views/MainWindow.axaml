<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgoraIn.App.ViewModels"
        x:Class="AgoraIn.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="AgoraIn v4"
        Icon="avares://AgoraIn/Assets/app-icon.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="48"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei">

  <Window.Styles>
    <!-- ═══ 标题栏扁平按钮（文件/远程/设置/帮助，沿用 v3 FlatButton：白字、圆角 4、悬停半透明白） ═══ -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20FFFFFF" />
    </Style>

    <!-- ═══ 模式切换下拉按钮（沿用 v3 ModeComboBox 外观：透明圆角 8、白字、悬停 #26FFFFFF） ═══ -->
    <Style Selector="Button.mode-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.mode-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Button.mode-btn.open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <!-- ═══ 窗口按钮 ═══ -->
    <Style Selector="Button.titlebar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20FFFFFF" />
    </Style>
    <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brand.Red}" />
    </Style>

    <!-- ═══ 任务树节点（沿用 v3：圆角 4、悬停 #e8f0fe、选中 #d2e3fc） ═══ -->
    <Style Selector="Border.tree-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="2,1" />
    </Style>
    <Style Selector="Border.tree-item:pointerover">
      <Setter Property="Background" Value="#e8f0fe" />
    </Style>
    <Style Selector="Border.tree-item.selected">
      <Setter Property="Background" Value="#d2e3fc" />
    </Style>
    <Style Selector="TextBlock.tree-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ 控制中心导航按钮（沿用 v3 NavButtonStyle：高 44、圆角 8、选中浅蓝） ═══ -->
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="44" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#888888" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f5f7fa" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Foreground" Value="#4285f4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#e8f0fe" />
    </Style>

    <!-- ═══ 学生打卡按钮（沿用 v3：高 52、圆角 8、灰底描边、打卡变蓝、悬停 0.85） ═══ -->
    <Style Selector="Button.student">
      <Setter Property="Height" Value="52" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#e8e8e8" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="BorderBrush" Value="#d0d0d0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.student:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.student.checked">
      <Setter Property="Background" Value="#4285f4" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4285f4" />
    </Style>

    <!-- ═══ 标签页（沿用 v3：高 36，激活白底加粗，未激活灰字） ═══ -->
    <Style Selector="Border.tab">
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tab.active">
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="TextBlock.tab-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#555555" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="120" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.tab.active TextBlock.tab-title">
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.tab-close">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="#999999" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ 通用卡片与占位文案 ═══ -->
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#333333" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#888888" />
    </Style>
    <Style Selector="TextBlock.placeholder-note">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border CornerRadius="12" ClipToBounds="True" Background="White">
    <Grid ColumnDefinitions="200,*">

      <!-- ═══════════ 左侧：任务列表侧边栏（沿用 v3：#f5f5f5，200px） ═══════════ -->
      <Border Grid.Column="0" Background="#f5f5f5">
        <Grid RowDefinitions="48,*">
          <Border Grid.Row="0" Background="#4285f4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Ellipse Width="10" Height="10" Fill="White" Opacity="0.9" />
              <TextBlock Text=" AgoraIn" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- 任务树（P0 占位样例；P2 parity 接入真实文件夹/任务两级树与右键菜单） -->
          <ScrollViewer Grid.Row="1" Padding="8,8,8,0">
            <StackPanel Spacing="1">
              <Border Classes="tree-item">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" Foreground="#666666" VerticalAlignment="Center" />
                  <TextBlock Classes="tree-label" Text="我的任务" />
                </StackPanel>
              </Border>
              <Border Classes="tree-item" Margin="18,1,2,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Foreground="#4285f4" VerticalAlignment="Center" />
                  <TextBlock Classes="tree-label" Text="默认任务 - 数学" />
                </StackPanel>
              </Border>
              <Border Classes="tree-item selected" Margin="18,1,2,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Foreground="#4285f4" VerticalAlignment="Center" />
                  <TextBlock Classes="tree-label" Text="1203 数学 签到 - 数学" />
                </StackPanel>
              </Border>
              <Border Classes="tree-item" Margin="18,1,2,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Foreground="#4285f4" VerticalAlignment="Center" />
                  <TextBlock Classes="tree-label" Text="口算比赛" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ═══════════ 右侧：主内容区 ═══════════ -->
      <Grid Grid.Column="1" RowDefinitions="48,36,*,28">

        <!-- 标题栏：模式下拉 + 菜单 + 窗口按钮 -->
        <Grid Grid.Row="0" Background="#4285f4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button x:Name="ModeButton" Classes="mode-btn" Margin="0,0,10,0" Click="OnModeButtonClick">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedMode.DisplayName}" VerticalAlignment="Center" />
                <Path Data="M 0,0 L 4,4 L 8,0" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Content="文件" Classes="flat" />
            <Button Content="远程" Classes="flat" />
            <Button Content="设置" Classes="flat" />
            <Button Content="帮助" Classes="flat" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Classes="titlebar" Click="OnMinimizeClick">
              <Path Data="M0,0 H10" Stroke="White" StrokeThickness="1" />
            </Button>
            <Button Classes="titlebar" Click="OnMaximizeClick">
              <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="White" StrokeThickness="1" Fill="Transparent" />
            </Button>
            <Button Classes="titlebar titlebar-close" Click="OnCloseClick">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 标签栏 -->
        <Border Grid.Row="1" Background="#f0f0f0" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
          <Panel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
              <Border Classes="tab active">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Classes="tab-title" Text="1203 数学 签到 - …" />
                  <TextBlock Classes="tab-close" Text="✕" />
                </StackPanel>
              </Border>
              <Border Classes="tab">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Classes="tab-title" Text="默认任务 - 数学" />
                  <TextBlock Classes="tab-close" Text="✕" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="+" FontSize="18" FontWeight="Light" Foreground="#666666"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
          </Panel>
        </Border>

        <!-- 主内容区：三模式切换 -->
        <Panel Grid.Row="2">

          <!-- ── 大屏模式（沿用 v3 TabContentTemplate：320px 排名卡 + 打卡面板） ── -->
          <Grid IsVisible="{Binding IsLargeScreen}" Margin="20,12,20,8" ColumnDefinitions="320,*">
            <Border Grid.Column="0" CornerRadius="8" Background="#f8f9fa" Padding="12" Margin="0,0,16,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="打卡排名" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Classes="hint" Text="最早打卡" Margin="0,0,0,8" />
                <StackPanel>
                  <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                    <Grid ColumnDefinitions="40,*,70">
                      <TextBlock Text="1" FontWeight="Bold" Foreground="{DynamicResource Rank.Gold}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="张三" VerticalAlignment="Center" FontSize="13" />
                      <TextBlock Grid.Column="2" Text="08:00:01" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                    <Grid ColumnDefinitions="40,*,70">
                      <TextBlock Text="2" FontWeight="Bold" Foreground="{DynamicResource Rank.Silver}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="李四" VerticalAlignment="Center" FontSize="13" />
                      <TextBlock Grid.Column="2" Text="08:00:15" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                    <Grid ColumnDefinitions="40,*,70">
                      <TextBlock Text="3" FontWeight="Bold" Foreground="{DynamicResource Rank.Bronze}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="王五" VerticalAlignment="Center" FontSize="13" />
                      <TextBlock Grid.Column="2" Text="08:00:42" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                    <Grid ColumnDefinitions="40,*,70">
                      <TextBlock Text="4" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="赵六" VerticalAlignment="Center" FontSize="13" />
                      <TextBlock Grid.Column="2" Text="08:01:03" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                    <Grid ColumnDefinitions="40,*,70">
                      <TextBlock Text="5" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="孙八" VerticalAlignment="Center" FontSize="13" />
                      <TextBlock Grid.Column="2" Text="08:01:17" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </StackPanel>
              </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                  <TextBlock Text="服务器在线" FontSize="13" Foreground="#666666" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand.Green}" IsVisible="{Binding IsOnline}" Margin="0,0,6,0" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand.Red}" IsVisible="{Binding !IsOnline}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding OnlineText}" FontSize="12" Foreground="#777777" />
                  </StackPanel>
                </Grid>

                <Border CornerRadius="8" Background="#e8f0fe" Padding="14,10" Margin="0,0,0,14">
                  <TextBlock Text="总人数: 12 ｜ 已打卡: 3 (25%)" FontSize="14" FontWeight="Medium" Foreground="#4285f4" />
                </Border>

                <UniformGrid Columns="6">
                  <Button Classes="student checked" Content="学生1" />
                  <Button Classes="student checked" Content="学生2" />
                  <Button Classes="student checked" Content="学生3" />
                  <Button Classes="student" Content="学生4" />
                  <Button Classes="student" Content="学生5" />
                  <Button Classes="student" Content="学生6" />
                  <Button Classes="student" Content="学生7" />
                  <Button Classes="student" Content="学生8" />
                  <Button Classes="student" Content="学生9" />
                  <Button Classes="student" Content="学生10" />
                  <Button Classes="student" Content="学生11" />
                  <Button Classes="student" Content="学生12" />
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ── 控制模式（沿用 v3 控制中心结构：左侧导航 + 统计条；P2 parity 等价迁移） ── -->
          <Grid IsVisible="{Binding IsControlMode}" ColumnDefinitions="200,*">
            <StackPanel Grid.Column="0" Margin="0,8,0,0">
              <Button Classes="nav selected" Content="划课" />
              <Button Classes="nav" Content="设备列表" />
              <Button Classes="nav" Content="任务中心" />
              <Button Classes="nav" Content="集控平台列表" />
            </StackPanel>
            <ScrollViewer Grid.Column="1" Background="#fafafa">
              <StackPanel Margin="24,20">
                <TextBlock Classes="page-title" Text="课时划消与排课" FontSize="18" />
                <UniformGrid Columns="3" Margin="0,16,0,0">
                  <Border CornerRadius="8" Background="#f8f9fa" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock Classes="hint" Text="设备总数" />
                      <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="#4285f4" />
                    </StackPanel>
                  </Border>
                  <Border CornerRadius="8" Background="#f8f9fa" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock Classes="hint" Text="任务总数" />
                      <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="#4285f4" />
                    </StackPanel>
                  </Border>
                  <Border CornerRadius="8" Background="#f8f9fa" Padding="14">
                    <StackPanel>
                      <TextBlock Classes="hint" Text="在线设备" />
                      <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="#34a853" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <TextBlock Classes="placeholder-note" Margin="0,16,0,0"
                           Text="学生课时管理、划消/赠送、42 格月历排课、自动扣课时（SlotKey 幂等）将在 P2 阶段自 v3.2 等价迁移。" />
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ── 教师模式（聚合点名 / 积分 / 值日 / 课表 / 答题卡，P3 / P7 实现） ── -->
          <Grid IsVisible="{Binding IsTeacherMode}" ColumnDefinitions="200,*">
            <StackPanel Grid.Column="0" Margin="0,8,0,0">
              <Button Classes="nav selected" Content="点名" />
              <Button Classes="nav" Content="积分" />
              <Button Classes="nav" Content="值日" />
              <Button Classes="nav" Content="课表" />
              <Button Classes="nav" Content="答题卡" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="教师模式" FontSize="16" Foreground="#bbbbbb" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <TextBlock Text="点名 / 积分 / 值日按 P3 计划落地，课表与 ClassIsland 联动按 P4，答题卡与 AI 阅卷按 P7"
                         FontSize="12" Foreground="#cccccc" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>

        </Panel>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#f5f5f5" Padding="12,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="就绪" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="右键点击已打卡学生可取消打卡" FontSize="11" Foreground="#aaaaaa" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>

  <!-- 模式切换下拉面板（沿用 v3：白色圆角 10 + 阴影，选项圆角 6、悬停/选中浅蓝蓝字） -->  <Popup x:Name="ModePopup" Placement="Bottom" PlacementTarget="{Binding #ModeButton}"
         IsLightDismissEnabled="True">
    <Border Background="White" CornerRadius="10" BorderBrush="#e0e0e0" BorderThickness="1"
            Margin="0,4,8,8" Padding="4" MinWidth="140"
            BoxShadow="0 4 16 0 #40000000">
      <ListBox Classes="mode-list" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
               SelectionChanged="OnModeListSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ModeOption">
            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.Styles>
          <Style Selector="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
          </Style>
          <Style Selector="ListBoxItem">
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
              <ControlTemplate>
                <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="12,7" Margin="2,1">
                  <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
              </ControlTemplate>
            </Setter>
          </Style>
          <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Foreground" Value="#4285f4" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#e8f0fe" />
          </Style>
          <Style Selector="ListBoxItem:selected">
            <Setter Property="Foreground" Value="#4285f4" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ Border#Bd">
            <Setter Property="Background" Value="#e8f0fe" />
          </Style>
        </ListBox.Styles>
      </ListBox>
    </Border>
  </Popup>
  </Panel>
</Window>
