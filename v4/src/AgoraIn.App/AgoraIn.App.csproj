<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia 桌面端（net10.0，Windows 优先交付，保持跨平台可编译）。
       依赖许可证：Avalonia* = MIT，CommunityToolkit.Mvvm = MIT -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AgoraIn</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>

    <!-- Microsoft.Web.WebView2 同时附带 WPF/WinForms 包装器程序集，它们引用 WPF 的
         WindowsBase 5.0.0.0，与 .NET 10 自带的 WindowsBase 4.0.0.0 产生版本冲突（MSB3277）。
         本项目只使用纯 Core API（Microsoft.Web.WebView2.Core），不引用任何 WPF/WinForms 类型，
         冲突不可达，故抑制该警告（共 22 条）。 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgoraIn.Core\AgoraIn.Core.csproj" />
    <ProjectReference Include="..\AgoraIn.Data\AgoraIn.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用图标沿用 v3.2 多尺寸 ICO（avares 资源，窗口 Icon 引用） -->
    <AvaloniaResource Include="Assets\app-icon.ico" />
  </ItemGroup>

</Project>
